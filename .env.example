# Copy to .env and fill in, or set these in the build environment.
#
# Vite inlines every VITE_* variable into the bundle, so nothing secret belongs
# in here. The reCAPTCHA site key is public by design -- it only works on the
# domains it was registered to -- which is why it can live in the client at all.

# reCAPTCHA v3 site key for Firebase App Check.
# Firebase console -> App Check -> register the web app with reCAPTCHA v3.
# Without it the app still runs, but the AI story suggestions will be refused
# once App Check enforcement is on.
VITE_APPCHECK_SITE_KEY=6Lf5Pc0tAAAAAPpMokQtaYxJMAhHst7bsrvvVzUi
